<%= turbo_stream.update "component-preview" do %>
  <div class="card sticky-top" style="top: 20px;">
    <div class="card-header bg-light">
      <h5 class="mb-0">Detalhes da Peça</h5>
    </div>
    <div class="card-body text-center">
      <% if @selected_component.present? %>
        <div class="mb-3" style="height: 200px; display: flex; align-items: center; justify-content: center; background-color: #f8f9fa; border-radius: 8px;">
          <% if @selected_component.image.attached? %>
            <%= image_tag @selected_component.image, class: "img-fluid", style: "max-height: 100%; object-fit: contain;" %>
          <% else %>
            <i class="fas fa-image" style="font-size: 3rem; color: #999;"></i>
          <% end %>
        </div>

        <h5 class="card-title"><%= @selected_component.name %></h5>
        <p class="text-muted mb-3"><strong><%= @selected_component.brand %></strong></p>

        <div class="mb-3">
          <span class="badge bg-success" style="font-size: 1.2rem; padding: 10px 15px;">
            R$ <%= number_to_currency(@selected_component.price, unit: "", delimiter: ".", separator: ",") %>
          </span>
        </div>

        <div class="specs mb-4 text-start">
          <h6 class="text-secondary mb-2">Especificações</h6>
          <% if @category == "CPU" %>
            <small class="d-block"><strong>Cores:</strong> <%= @selected_component.name %></small>
            <small class="d-block"><strong>Frequência:</strong> <%= @selected_component.price %>GHz</small>
            <small class="d-block"><strong>Socket:</strong> <%= @selected_component.ram_speed %>GHz</small>
          <% elsif @category == "GPU" %>
            <small class="d-block"><strong>VRAM:</strong> <%= @selected_component.architecture %>GB</small>
            <small class="d-block"><strong>Arquitetura:</strong> <%= @selected_component.architecture %></small>
            <small class="d-block"><strong>Potência:</strong> <%= @selected_component.wattage %>W</small>
          <% elsif @category == "RAM" %>
            <small class="d-block"><strong>Capacidade:</strong> <%= @selected_component.capacity %>GB</small>
            <small class="d-block"><strong>Tipo:</strong> <%= @selected_component.ram_type %></small>
            <small class="d-block"><strong>Velocidade:</strong> <%= @selected_component.speed %>MHz</small>
          <% end %>
        </div>

        <button class="btn btn-success w-100 btn-lg" data-action="click->mounting-form#nextStep">
          <i class="fas fa-arrow-right"></i> Avançar
        </button>
      <% else %>
        <div style="padding: 40px 20px;">
          <i class="fas fa-cube" style="font-size: 3rem; color: #ccc; margin-bottom: 20px;"></i>
          <p class="text-muted">Selecione uma peça para ver os detalhes</p>
        </div>
      <% end %>
    </div>
  </div>
<% end %>