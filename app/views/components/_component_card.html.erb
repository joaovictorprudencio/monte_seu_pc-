<turbo-frame id="component-<%= component.id %>" 
             data-id="<%= component.id %>"
             data-category="<%= category %>">
  
  <div class="card h-100 cursor-pointer"
       data-controller="select-component"
       data-component-id="<%= component.id %>"
       data-action="click->select-component#select">
    
    <div class="d-flex align-items-center justify-content-center overflow-hidden bg-body-tertiary" style="height: 150px;">
      <img src="<%= component.display_image %>"
             alt="<%= component.name %>"
             class="img-fluid object-fit-contain">
    </div>

    <div class="card-body">
      <h6 class="card-title">
        <%= component.name %>
      </h6>
      
      <p class="text-muted small mb-2">
        <%= component.brand %>
      </p>

      <div class="mb-2">
        <span class="badge bg-info">
          R$ <%= number_to_currency(component.price, unit: "", delimiter: ".", separator: ",") %>
        </span>
      </div>

    </div>

    <div class="card-footer bg-white border-top-0">
      <small class="text-muted">Clique para selecionar</small>
    </div>
  </div>
</turbo-frame>
 