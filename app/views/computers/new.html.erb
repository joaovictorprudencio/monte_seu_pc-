<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card shadow-sm">
        <div class="card-header">
          <h4 class="mb-0">Nova montagem</h4>
        </div>
        <div class="card-body">
          <% if @computer.errors.any? %>
            <div class="alert alert-danger" role="alert">
              <h5 class="alert-heading"><%= pluralize(@computer.errors.count, "erro") %> impediram o salvamento:</h5>
              <ul class="mb-0">
                <% @computer.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <%= form_with model: @computer, data: { turbo: false } do |form| %>
            <div class="mb-3">
              <%= form.label :name, "Nome", class: "form-label" %>
              <%= form.text_field :name, class: "form-control", placeholder: "Ex: PC gamer" %>
            </div>

            <div class="mb-3">
              <%= form.label :description, "Descrição", class: "form-label" %>
              <%= form.text_area :description, class: "form-control", rows: 3,
                                 placeholder: "Descreva sua montagem" %>
            </div>

            <%= form.submit "Salvar", class: "btn btn-primary" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
